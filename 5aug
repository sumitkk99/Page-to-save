@Test
void reactiveTroubleshootWifiAnalyzerEntry_withWhmOfferRedemption() {
    // Setup request with whmRedeemEligible and whmOfferRedemption
    MobileFirstRequestVO request = new MobileFirstRequestVO();
    request.getRequestParams().put("whmRedeemEligible", "true");
    request.getRequestParams().put("whmOfferRedemption", "sampleRedemption");

    // Mock dependencies
    when(deviceMgmtUtil.isARSupported(any(), any())).thenReturn(Mono.just(Boolean.TRUE));
    MobileFirstResponseVO response = new MobileFirstResponseVO();
    when(aemHandler.buildResponse(any(), any())).thenReturn(Mono.just(new ResponseEntity<>(response, HttpStatus.OK)));
    when(deviceMgmtUtil.updateNavigationBarByPattern(any(), any(), any(), any(), any())).thenReturn(Mono.just(new ResponseEntity<>(response, HttpStatus.OK)));
    when(env.getProperty("CPCLandingURL")).thenReturn("https://cpc.example.com");

    // Call the service method
    Mono<ResponseEntity<MobileFirstResponseVO>> result = deviceMgmtServiceImpl.reactiveTroubleshootWifiAnalyzerEntry(serverWebExchange, request);

    // Assert the result
    assertEquals(HttpStatus.OK, result.block().getStatusCode());
}
