    @Autowired
    private BPMHelper1 bpmHelper1;

    public Mono<Customer> getCustomerInfo_Lines(GetCustomerInfoRequest request) {
        // Assuming this service is integrated with cxpCustomerService and sessionHelper, as in the previous code.
        return cxpCustomerService.retrieveCustomerInfo_lines(customerRequestType)
                .flatMap(customer -> bpmHelper1.getLocationViolationStatus(AccountLandingConstants.CHANNEL_ID, request.getAccountNumber())
                        .flatMap(getCasesResponse -> {
                            List<FWALocationViolationInfo> violationInfos = customer.getData().getCustomerProfile().getBillAccounts().stream()
                                    .flatMap(billAccount -> billAccount.getMtns().stream())
                                    .map(mtn -> {
                                        FWALocationViolationInfo violationInfo = processMtn(mtn.getMtn(), getCasesResponse);
                                        return violationInfo != null ? violationInfo : null;
                                    })
                                    .collect(Collectors.toList());

                            customer.getData().getCustomerProfile().setFwaLocationViolationInfos(violationInfos);
                            return Mono.just(customer.getData().getCustomerProfile());
                        })
                );
    }

    private FWALocationViolationInfo processMtn(String mtn, GetCasesResponse getCasesResponse) {
        List<FWALocationViolationLines> violationLines = processLocationViolationCases(mtn, getCasesResponse);

        if (violationLines.isEmpty()) {
            return null; // No violations for this MTN
        }

        FWALocationViolationInfo violationInfo = new FWALocationViolationInfo();
        violationInfo.setFwaLocationViolationLines(violationLines);

        if (violationLines.size() > 1) {
            violationInfo.setGenericLVBanner(true);
        } else {
            FWALocationViolationLines singleLine = violationLines.get(0);
            violationInfo.setMtn(singleLine.getMin());
            violationInfo.setCaseStatus(singleLine.getCaseStatus());
            violationInfo.setGenericLVBanner(false);
        }

        return violationInfo;
    }

    private List<FWALocationViolationLines> processLocationViolationCases(String mtn, GetCasesResponse getCasesResponse) {
        // Logic to process and filter cases specifically for the given MTN.
        // Replace the mock data with actual logic based on getCasesResponse.
        return getCasesResponse.getCases().stream()
                .filter(case -> case.getMtn().equals(mtn))
                .map(case -> new FWALocationViolationLines(case.getMtn(), determineCaseStatus(case)))
                .collect(Collectors.toList());
    }

    private String determineCaseStatus(LocationViolationCaseSearch case) {
        // Implement the logic to determine case status based on specific conditions.
        // For example:
        if (case.isPending()) {
            return "Pending-LVSpeedcap";
        } else if (case.isApplied()) {
            return "LVSpeedCapApplied";
        } else {
            return "GenericLVSpeedCap";
        }
    }
}
