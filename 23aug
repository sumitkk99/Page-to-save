   public static LocationViolationServiceRequest createLocationViolationRequest(String accountNumber, String mtn) {
        LocationViolationCaseSearch caseSearch = new LocationViolationCaseSearch();
        caseSearch.setAccountNumber(accountNumber);
        caseSearch.setCaseStatus("ALL");
        caseSearch.setCaseType(Collections.singletonList("NetworkOutage"));
        caseSearch.setIntent("Location Violation");
        caseSearch.setShowCaseHierarchyFlag("true");

        LocationViolationServiceRequestBody requestBody = new LocationViolationServiceRequestBody();
        requestBody.setServiceRequest(caseSearch);

        LocationViolationServiceRequest request = new LocationViolationServiceRequest();
        request.setServiceBody(requestBody);

        return request;
    }
