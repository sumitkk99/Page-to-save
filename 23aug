@Test
public void invokeBPMGetCasesNWOTest_Successful() throws SOEHTTPException {
    // Prepare the response that should be returned when service.bpmGetCasesNWO is called
    final var getCasesLVResponse = new GetCasesLVResponse();
    when(service.bpmGetCasesNWO(any())).thenReturn(Mono.just(getCasesLVResponse));
    
    // Execute the method and verify the response
    create(bpmService.invokeBPMGetCasesNWO(new BPMServiceRequest()))
        .assertNext(response -> {
            assertThat(response).isNotNull();
            assertThat(response).isEqualTo(getCasesLVResponse);
        })
        .expectComplete().verify();
}

@Test
public void invokeBPMGetCasesNWOTest_HTTPException() throws SOEHTTPException {
    // Prepare the SOEHTTPException that should be thrown
    final var soeErrorHolder = commonSoeHttpException();
    when(service.bpmGetCasesNWO(any())).thenReturn(Mono.error(new SOEHTTPException(500, soeErrorHolder)));

    // Execute the method and verify that the error handling works correctly
    create(bpmService.invokeBPMGetCasesNWO(new BPMServiceRequest()))
        .assertNext(response -> {
            assertThat(response).isNotNull();
            assertThat(response.getErrors()).isNotEmpty();
            assertThat(response.getErrors().get(0).getMessage()).isEqualTo("VALIDATION_ERROR");
        })
        .expectComplete().verify();
}

