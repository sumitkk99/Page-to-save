import onevz.soe.accountlanding.exceptions.SOEHTTPException;
import onevz.soe.accountlanding.model.BPMServiceRequest;
import onevz.soe.accountlanding.model.GetCasesLVResponse;
import onevz.soe.accountlanding.util.AccountLandingUtil;
import onevz.soe.accountlanding.services.BPMServiceImpl;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import reactor.core.publisher.Mono;
import reactor.test.StepVerifier;
import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
public class BPMServiceImplTest {

    @InjectMocks
    private BPMServiceImpl bpmServiceImpl;

    @Mock
    private ExternalService service; // Assuming this is the service that handles the actual BPM call

    // Mock SOEErrorHolder and SOEHTTPException for the HTTP exception scenario
    private SOEErrorHolder buildSOEErrorHolder() {
        SOEError error = new SOEError();
        error.setId("501");
        error.setCategory("HIGH");
        error.setMessage("VALIDATION_ERROR");
        SOEErrorHolder errorHolder = new SOEErrorHolder();
        errorHolder.setErrors(List.of(error));
        return errorHolder;
    }

    @Test
    public void invokeBPMGetCasesNWO_HTTPExceptionTest() {
        // Arrange
        var soeErrorHolder = buildSOEErrorHolder();
        when(service.bpmGetCasesNWO(any()))
                .thenReturn(Mono.error(() -> new SOEHTTPException(500, soeErrorHolder)));

        // Act & Assert
        StepVerifier.create(bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest()))
                .assertNext(getCasesResponse -> {
                    assertThat(getCasesResponse).isNotNull();
                    assertThat(getCasesResponse.getErrors()).isNotEmpty().hasSize(1);
                    assertThat(getCasesResponse.getErrors().get(0).getMessage()).isEqualTo("VALIDATION_ERROR");
                })
                .expectComplete()
                .verify();
    }

    @Test
    public void invokeBPMGetCasesNWO_GeneralExceptionTest() {
        // Arrange
        when(service.bpmGetCasesNWO(any()))
                .thenReturn(Mono.error(IllegalArgumentException::new));

        // Act & Assert
        StepVerifier.create(bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest()))
                .assertNext(getCasesResponse -> {
                    assertThat(getCasesResponse).isNotNull();
                    assertThat(getCasesResponse.getErrors()).isNotEmpty().hasSize(1);
                    assertThat(getCasesResponse.getErrors().get(0).getMessage()).isEqualTo("java.lang.IllegalArgumentException");
                })
                .expectComplete()
                .verify();
    }

    @Test
    public void invokeBPMGetCasesNWO_SuccessfulCallTest() {
        // Arrange
        GetCasesLVResponse response = new GetCasesLVResponse();
        when(service.bpmGetCasesNWO(any())).thenReturn(Mono.just(response));

        // Act & Assert
        StepVerifier.create(bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest()))
                .assertNext(getCasesResponse -> {
                    assertThat(getCasesResponse).isNotNull();
                    assertThat(getCasesResponse.getErrors()).isEmpty();
                })
                .expectComplete()
                .verify();
    }

    @Test
    public void invokeBPMGetCasesNWO_EmptyResponseTest() {
        // Arrange
        when(service.bpmGetCasesNWO(any())).thenReturn(Mono.empty());

        // Act & Assert
        StepVerifier.create(bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest()))
                .assertNext(getCasesResponse -> {
                    assertThat(getCasesResponse).isNotNull();
                    assertThat(getCasesResponse.getErrors()).isEmpty();
                })
                .expectComplete()
                .verify();
    }
}
