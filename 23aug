#### **Test 1: Successful Response with Location Violation Enabled**
This test case simulates the scenario where the location violation feature is enabled and returns expected data.

```java
@Test
public void testGetCustomerInfoLines_LocationViolationEnabled() {
    // Arrange
    GetCustomerInfoRequest request = new GetCustomerInfoRequest();
    request.setAccountNumber("12345-67890");

    CustomerRequestType customerRequestType = new CustomerRequestType();
    customerRequestType.setCustomerId(request.getAccountNumber());
    customerRequestType.setRetrieveDeactivePriceplans(true);

    CustomerProfileGraphQLAssistedResponse customerProfileResponse = new CustomerProfileGraphQLAssistedResponse();
    CustomerProfile customerProfile = new CustomerProfile();
    customerProfile.setBillAccounts(new ArrayList<>());
    Data data = new Data();
    data.setCustomerProfile(customerProfile);
    customerProfileResponse.setData(data);

    GetCasesLVResponse casesLVResponse = new GetCasesLVResponse();
    List<Case> cases = new ArrayList<>();
    Case lvCase = new Case();
    lvCase.setMtnImpacted("9087654321");
    lvCase.setCaseStatus("Pending-LVSpeedcap");
    cases.add(lvCase);
    casesLVResponse.setServiceBody(new ServiceBody(new ServiceResponse(cases)));

    when(cxpCustomerService.retrieveCustomerInfoLines(any(CustomerRequestType.class)))
            .thenReturn(Mono.just(customerProfileResponse));
    when(bpmHelper1.getLocationViolationStatus(anyString(), anyString()))
            .thenReturn(Mono.just(casesLVResponse));
    when(featureFlag.isFeatureEnabled(anyString(), anyString(), anyString(), anyBoolean()))
            .thenReturn(Mono.just(true));
    when(sessionHelper.upsertDataInRedisMono(anyMap()))
            .thenReturn(Mono.just(new HashMap<>()));

    // Act
    Mono<CustomerProfile> result = customerInfoService.getCustomerInfoLines(request);

    // Assert
    StepVerifier.create(result)
            .expectNextMatches(customerProfileResult -> {
                assertNotNull(customerProfileResult.getFwaLocationViolationInfo());
                assertTrue(customerProfileResult.getFwaLocationViolationInfo().isGenericLVBanner());
                assertEquals(1, customerProfileResult.getFwaLocationViolationInfo().getFwaLocationViolationLines().size());
                return true;
            })
            .verifyComplete();

    verify(cxpCustomerService, times(1)).retrieveCustomerInfoLines(any(CustomerRequestType.class));
    verify(bpmHelper1, times(1)).getLocationViolationStatus(anyString(), anyString());
    verify(featureFlag, times(1)).isFeatureEnabled(anyString(), anyString(), anyString(), anyBoolean());
    verify(sessionHelper, times(1)).upsertDataInRedisMono(anyMap());
}
```

