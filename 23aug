package onevz.soe.accountlanding.service;

import onevz.soe.accountlanding.helper.BPMHelper1;
import onevz.soe.accountlanding.model.bpm.GetCasesResponse;
import onevz.soe.accountlanding.model.soe.Customer;
import onevz.soe.accountlanding.model.soe.FWALocationViolationInfo;
import onevz.soe.accountlanding.model.soe.FWALocationViolationLines;
import onevz.soe.accountlanding.util.AccountLandingConstants;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

@Service
public class GetCustomerInfoService {

    @Autowired
    private BPMHelper1 bpmHelper1;

    // The main method where you'll integrate the new logic
    public Mono<Customer> getCustomerInfo_Lines(GetCustomerInfoRequest request) {

        // Start of your existing logic
        CustomerRequestType customerRequestType = new CustomerRequestType();
        if (request != null && request.getAccountNumber() != null && !request.getAccountNumber().isEmpty()) {
            customerRequestType.setCustomerId(request.getAccountNumber());
            customerRequestType.setRetrieveDeactivePriceplans(true);
        }

        Mono<CustomerProfileGraphQLAssistedResponse> customerInfo = cxpCustomerService.retrieveCustomerInfo_lines(customerRequestType);
        Mono<Boolean> featureFlagMono = featureFlag.isFeatureEnabled(FeatureFlagConstants.APPLICATION_NAME_FWA_DEFAULT,
                FeatureFlagConstants.CONFIG_PROFILE_FWA_ADDONS, FeatureFlagConstants.FLAG_NAME_FWA_WHWSPO_MODE_FFAG, true);

        return Mono.zip(customerInfo, featureFlagMono)
                .flatMap(tuple -> {
                    CustomerProfileGraphQLAssistedResponse customer = tuple.getT1();
                    // Add your customer profile processing logic here

                    // After processing customer data, now integrate BPMHelper1 for Location Violation Cases
                    return bpmHelper1.getLocationViolationStatus(AccountLandingConstants.CHANNEL_ID, request.getAccountNumber())
                            .flatMap(getCasesResponse -> {
                                // Initialize an empty list to store violation information for each MTN
                                List<FWALocationViolationInfo> violationInfos = new ArrayList<>();

                                // Process each MTN (Mobile Telephone Number) individually
                                for (String mtn : request.getMtns()) {
                                    FWALocationViolationInfo violationInfo = processMtn(mtn, getCasesResponse);
                                    if (violationInfo != null) {
                                        violationInfos.add(violationInfo);
                                    }
                                }

                                // Set the violation information list to the customer profile
                                Customer customerProfile = customer.getData().getCustomerProfile();
                                customerProfile.setFwaLocationViolationInfos(violationInfos);

                                return Mono.just(customerProfile);
                            });
                });
    }

    // Method to process each MTN and get the violation status
    private FWALocationViolationInfo processMtn(String mtn, GetCasesResponse getCasesResponse) {
        List<FWALocationViolationLines> violationLines = processLocationViolationCases(mtn, getCasesResponse);

        if (violationLines.isEmpty()) {
            return null; // No violations for this MTN
        }

        FWALocationViolationInfo violationInfo = new FWALocationViolationInfo();
        violationInfo.setFwaLocationViolationLines(violationLines);

        if (violationLines.size() > 1) {
            violationInfo.setGenericLVBanner(true);
        } else {
            FWALocationViolationLines singleLine = violationLines.get(0);
            violationInfo.setMtn(singleLine.getMin());
            violationInfo.setCaseStatus(singleLine.getCaseStatus());
            violationInfo.setGenericLVBanner(false);
        }

        return violationInfo;
    }

    // Method to process location violation cases based on the response from BPMHelper1
    private List<FWALocationViolationLines> processLocationViolationCases(String mtn, GetCasesResponse getCasesResponse) {
        return getCasesResponse.getCases().stream()
                .filter(locationViolationCase -> locationViolationCase.getMtn().equals(mtn))
                .map(locationViolationCase -> new FWALocationViolationLines(locationViolationCase.getMtn(), determineCaseStatus(locationViolationCase)))
                .collect(Collectors.toList());
    }

    // Helper method to determine the case status for each violation
    private String determineCaseStatus(LocationViolationCaseSearch locationViolationCase) {
        if (locationViolationCase.isPending()) {
            return "Pending-LVSpeedcap";
        } else if (locationViolationCase.isApplied()) {
            return "LVSpeedCapApplied";
        } else {
            return "GenericLVSpeedCap";
        }
    }
}
