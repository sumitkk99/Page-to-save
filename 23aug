import onevz.soe.accountlanding.services.BPMServiceImpl;
import onevz.soe.accountlanding.model.BPMServiceRequest;
import onevz.soe.accountlanding.model.GetCasesLVResponse;
import onevz.soe.accountlanding.exceptions.SOEHTTPException;
import onevz.soe.accountlanding.util.AccountLandingUtil;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import reactor.core.publisher.Mono;
import reactor.test.StepVerifier;
import java.util.ArrayList;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
public class BPMServiceImplTest {

    @InjectMocks
    private BPMServiceImpl bpmServiceImpl;

    @Mock
    private ExternalService service; // Assuming this is the service that handles the actual BPM call

    @BeforeEach
    public void setup() {
        // Any setup steps, if necessary
    }

    @Test
    public void testInvokeBPMGetCasesNWO_Success() {
        // Prepare the data to return
        GetCasesLVResponse response = new GetCasesLVResponse();
        // Set any required fields in the response object

        // Mock the ExternalService to return the response
        when(service.bpmGetCasesNWO(any(BPMServiceRequest.class)))
                .thenReturn(Mono.just(response));

        // Execute the method to test
        Mono<GetCasesLVResponse> resultMono = bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest());

        // Verify the results
        StepVerifier.create(resultMono)
                .expectNext(response)
                .verifyComplete();

        // Verify that the service.bpmGetCasesNWO method was called
        verify(service, times(1)).bpmGetCasesNWO(any(BPMServiceRequest.class));
    }

    @Test
    public void testInvokeBPMGetCasesNWO_HTTPException() {
        // Prepare the exception to be thrown
        SOEHTTPException exception = new SOEHTTPException("HTTP error", null);

        // Mock the ExternalService to throw an exception
        when(service.bpmGetCasesNWO(any(BPMServiceRequest.class)))
                .thenReturn(Mono.error(exception));

        // Execute the method to test
        Mono<GetCasesLVResponse> resultMono = bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest());

        // Verify the results
        StepVerifier.create(resultMono)
                .assertNext(response -> {
                    assertEquals(1, response.getErrors().size());
                    assertEquals("HTTP error", response.getErrors().get(0).getMessage());
                })
                .verifyComplete();
    }

    @Test
    public void testInvokeBPMGetCasesNWO_OtherException() {
        // Prepare the exception to be thrown
        Exception exception = new Exception("General error");

        // Mock the ExternalService to throw an exception
        when(service.bpmGetCasesNWO(any(BPMServiceRequest.class)))
                .thenReturn(Mono.error(exception));

        // Execute the method to test
        Mono<GetCasesLVResponse> resultMono = bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest());

        // Verify the results
        StepVerifier.create(resultMono)
                .assertNext(response -> {
                    assertEquals(1, response.getErrors().size());
                    assertEquals("General error", response.getErrors().get(0).getMessage());
                })
                .verifyComplete();
    }

    @Test
    public void testInvokeBPMGetCasesNWO_EmptyResponse() {
        // Mock the ExternalService to return an empty Mono
        when(service.bpmGetCasesNWO(any(BPMServiceRequest.class)))
                .thenReturn(Mono.empty());

        // Execute the method to test
        Mono<GetCasesLVResponse> resultMono = bpmServiceImpl.invokeBPMGetCasesNWO(new BPMServiceRequest());

        // Verify the results
        StepVerifier.create(resultMono)
                .assertNext(response -> {
                    assertEquals(0, response.getErrors().size());
                })
                .verifyComplete();
    }
}
