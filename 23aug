// New Logic: Method to populate FWALocationViolationLines list
    private void populateFWALocationViolationLines(List<FWALocationViolationLines> lines, GetCasesResponse bpmCasesResponse, CustomerProfileGraphQLAssistedResponse customerProfile) {
        for (Case caseItem : bpmCasesResponse.getServiceBody().getServiceResponse().getCases()) {
            FWALocationViolationLines line = new FWALocationViolationLines();
            line.setMtn(caseItem.getMtnimpacted());
            line.setCaseStatus(caseItem.getCaseStatus());
            lines.add(line);
        }
    }
