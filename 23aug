package onevz.soe.accountlanding.service;

import onevz.soe.accountlanding.helper.BPMHelper1;
import onevz.soe.accountlanding.model.FwaLocationViolationLine;
import onevz.soe.accountlanding.model.SoeResponse;
import onevz.soe.wsclient.bpm.model.response.GetCasesResponse;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.util.ArrayList;
import java.util.List;

@Service
public class LocationViolationService {

    @Autowired
    private BPMHelper1 bpmHelper1;

    public Mono<SoeResponse> getLocationViolationInfo(String accountNumber) {
        return bpmHelper1.getLocationViolationStatus("VZW-MFA", accountNumber)
                .flatMap(response -> {
                    List<FwaLocationViolationLine> violationLines = processLocationViolationResponse(response);

                    SoeResponse soeResponse = new SoeResponse();
                    soeResponse.setSecondNumPlanExists(false);
                    
                    if (!violationLines.isEmpty()) {
                        soeResponse.setFwaLocationViolationInfo(violationLines);
                        soeResponse.setGenericLVBanner(violationLines.size() > 1);
                    }

                    return Mono.just(soeResponse);
                });
    }

    private List<FwaLocationViolationLine> processLocationViolationResponse(GetCasesResponse response) {
        List<FwaLocationViolationLine> violationLines = new ArrayList<>();

        if (response != null && response.getServiceBody() != null) {
            List<CaseDetail> cases = response.getServiceBody().getServiceResponse().getCases();

            if (cases != null) {
                for (CaseDetail caseDetail : cases) {
                    FwaLocationViolationLine violationLine = new FwaLocationViolationLine();
                    violationLine.setMtn(caseDetail.getMtnImpacted());

                    if (cases.size() > 1) {
                        violationLine.setCaseStatus("GenericLVSpeedCap");
                    } else if ("Pending-LVSpeedcap".equalsIgnoreCase(caseDetail.getCaseStatus())) {
                        violationLine.setCaseStatus("Pending-LVSpeedcap");
                    } else {
                        violationLine.setCaseStatus("LVSpeedCapApplied");
                    }

                    violationLines.add(violationLine);
                }
            }
        }

        return violationLines;
    }
}
