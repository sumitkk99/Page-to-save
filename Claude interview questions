## 24. Sorting Integers in Ascending Order



```java

Public class SortingExample {

    // Using Arrays.sort

    Public int[] sortArray(int[] numbers) {

        Arrays.sort(numbers);

        Return numbers;

    }

    

    // Using Stream API

    Public List<Integer> sortList(List<Integer> numbers) {

        Return numbers.stream()

            .sorted()

            .collect(Collectors.toList());

    }

    

    // Custom implementation (Bubble Sort)

    Public int[] bubbleSort(int[] arr) {

        Int n = arr.length;

        For (int i = 0; i < n – 1; i++) {

            For (int j = 0; j < n – i – 1; j++) {

                If (arr[j] > arr[j + 1]) {

                    Int temp = arr[j];

                    Arr[j] = arr[j + 1];

                    Arr[j + 1] = temp;

                }

            }

        }

        Return arr;

    }

}

```



## 25. Types of Exceptions with Examples



### Checked Exceptions

```java

// Custom checked exception

Public class FileProcessingException extends Exception {

    Public FileProcessingException(String message) {

        Super(message);

    }

}



// Using checked exception

Public class FileProcessor {

    Public void processFile(String path) throws FileProcessingException {

        Try {

            Files.readAllLines(Path.of(path));

        } catch (IOException e) {

            Throw new FileProcessingException(“Error processing file: “ + e.getMessage());

        }

    }

}

```



### Unchecked Exceptions

```java

// Custom runtime exception

Public class BusinessException extends RuntimeException {

    Public BusinessException(String message) {

        Super(message);

    }

}



// Using unchecked exception

Public class BusinessService {

    Public void processBusinessLogic(String input) {

        If (input == null || input.isEmpty()) {

            Throw new BusinessException(“Input cannot be empty”);

        }

    }

}

```



