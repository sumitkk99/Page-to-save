---

Refactored Approach

You can create a utility method that handles promo details and returns a list of AddOnsChanrgesDetail or MonthlyChargesDetail.

Refactored Method

private <T> void processPromoDetails(
        boolean featureFlagEnabled,
        MtnCharge mtnCharge,
        List<T> dueMonthlyList,
        List<T> nextMonthlyList,
        Function<T> instanceSupplier
) {
    if (!featureFlagEnabled) {
        return;
    }

    processSinglePromo(mtnCharge.getPromolDiscount(), mtnCharge.getPromolDesc(), 
        mtnCharge.isHasNextMonthPromoDiscount(), mtnCharge.isHasThisMonthPromoDiscount(),
        mtnCharge.getPromo1EndDate(), dueMonthlyList, nextMonthlyList, instanceSupplier);
    
    processSinglePromo(mtnCharge.getPromo2Discount(), mtnCharge.getPromo2Desc(), 
        mtnCharge.isHasNextMonthPromoDiscount(), mtnCharge.isHasThisMonthPromoDiscount(),
        mtnCharge.getPromo2EndDate(), dueMonthlyList, nextMonthlyList, instanceSupplier);

    processSinglePromo(mtnCharge.getPromo3Discount(), mtnCharge.getPromo3Desc(), 
        mtnCharge.isHasNextMonthPromoDiscount(), mtnCharge.isHasThisMonthPromoDiscount(),
        mtnCharge.getPromo3EndDate(), dueMonthlyList, nextMonthlyList, instanceSupplier);
}

private <T> void processSinglePromo(
        String discount,
        String desc,
        boolean hasNextMonthPromo,
        boolean hasThisMonthPromo,
        String promoEndDate,
        List<T> dueMonthlyList,
        List<T> nextMonthlyList,
        Function<T> instanceSupplier
) {
    if (StringUtilities.isNotEmptyOrNull(discount) && StringUtilities.isNotEmptyOrNull(desc)) {
        BigDecimal promoValue = new BigDecimal(discount);
        if (promoValue.compareTo(BigDecimal.ZERO) != 0) {
            T dueMonthlyPromo = instanceSupplier.apply();
            setPromoDetails(dueMonthlyPromo, desc, discount, hasNextMonthPromo, hasThisMonthPromo, promoEndDate);
            dueMonthlyList.add(dueMonthlyPromo);

            T nextMonthlyPromo = instanceSupplier.apply();
            setPromoDetails(nextMonthlyPromo, desc, discount, hasNextMonthPromo, hasThisMonthPromo, promoEndDate);
            nextMonthlyList.add(nextMonthlyPromo);
        }
    }
}

private <T> void setPromoDetails(T promo, String desc, String discount, boolean hasNextMonthPromo, boolean hasThisMonthPromo, String promoEndDate) {
    if (promo instanceof AddOnsChanrgesDetail) {
        AddOnsChanrgesDetail details = (AddOnsChanrgesDetail) promo;
        details.setItem(desc);
        details.setPrice(discount);
        details.setHasNextMonthPromoDiscount(hasNextMonthPromo);
        details.setHasThisMonthPromoDiscount(hasThisMonthPromo);
        details.setPromoEndDate(promoEndDate);
    } else if (promo instanceof MonthlyChargesDetail) {
        MonthlyChargesDetail details = (MonthlyChargesDetail) promo;
        details.setItem(desc);
        details.setPrice(discount);
        details.setHasNextMonthPromoDiscount(hasNextMonthPromo);
        details.setHasThisMonthPromoDiscount(hasThisMonthPromo);
        details.setPromoEndDate(promoEndDate);
    }
}


