public Mono<Void> setFeatureFlags(OrderConfirmationRedesignResponse orderConfirmationRedesignResponse, SsoJwtDTO ssoJwtDTO) {
    if (ssoJwtDTO == null || ssoJwtDTO.getVzwAccountNumber() == null || ssoJwtDTO.getVzwAccountNumber().isEmpty()) {
        return Mono.empty(); // Return an empty Mono to maintain reactive flow
    }

    return featureFlagIntegrationService.getFeatureFlagsWithThrottle(ssoJwtDTO.getVzwAccountNumber())
        .defaultIfEmpty(new HashMap<>()) // If Mono emits null, replace it with an empty map
        .map(featureFlags -> {
            featureFlags.put(ActivationConstants.SHOW_MULTIPLE_ORDER_NUMBERS_IN_IOC_FLAG, 
                             featureFlagIntegrationService.showMultipleOrderNumbersInIOCFFlag());
            return featureFlags;
        })
        .doOnNext(orderConfirmationRedesignResponse::setFeatureFlags)
        .then(); // Returns Mono<Void> to indicate completion
}
