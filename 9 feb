@RunWith(SpringJUnit4ClassRunner.class)
@SpringBootTest(classes = {ActivationServiceTestConfig.class}, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
@AutoConfigureWebTestClient(timeout = "100000")
public class OrderConfirmationRedesignControllerTest2 {

    @Autowired
    private WebTestClient webTestClient; // ✅ Fix: Properly Autowired WebTestClient

    @Autowired
    private OrderConfirmationRedesignController controller; // ✅ Fix: Use @Autowired instead of @InjectMocks

    @MockBean
    private RedisHelper redisHelper;

    @MockBean
    private OrderConfirmationRedesignHelper orderConfirmationRedesignHelper;

    @MockBean
    private ErrorHandlerHelper errorHandler;

    @MockBean
    private OrderConfirmationRedesignService service;

    @MockBean
    private FeatureFlagIntegrationService featureFlagIntegrationService;

    @Test
    public void initBinderByNameTest() {
        WebDataBinder binder = new WebDataBinder(null);
        controller.initBinderByName(binder);
        assertNotNull(binder.getDisallowedFields());
    }

    @Test
    public void testGetConfirmationRedesignPageInfo() throws Exception {
        // ✅ Read JSON files and parse objects
        ObjectMapper mapper = new ObjectMapper();
        String requestString = TestingHelper.readFromFile("OrderConfirmationRequest.json");
        String responseString = TestingHelper.readFromFile("OrderConfirmationRedesignResponse.json");

        OrderConfirmationRequest request = mapper.readValue(requestString, OrderConfirmationRequest.class);
        OrderConfirmationRedesignResponse response = mapper.readValue(responseString, OrderConfirmationRedesignResponse.class);

        RedisReqData redisReq = RedisReqData.builder()
                .cartId("")
                .userDeviceType("desktop")
                .cjevent("cjevent")
                .affiliate("affiliate")
                .completedCartId("3efad59a-f94e-45fa-9ed9-fd72aeae9bd5")
                .build();

        // ✅ Mock Dependencies Properly
        Mockito.when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReq));
        Mockito.when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(Mockito.any())).thenReturn(Mono.just(Boolean.TRUE));
        Mockito.when(service.getConfirmationPageRedesignInfo(Mockito.any())).thenReturn(Mono.just(response));
        Mockito.when(redisHelper.upsertDataInRedis(Mockito.any())).thenReturn(Mono.just(true));
        Mockito.when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(Mockito.any(), Mockito.any())).thenReturn(response);

        // ✅ Use WebTestClient to test API call
        webTestClient.post()
                .uri("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .accept(MediaType.APPLICATION_JSON)
                .header("channelId", "VZW-MFA-ANDROID")
                .header("x-soe-apikey", "uFWjz14du5e46whYg73iCGqriX2162C9")
                .header("UserAgent", "MF")
                .body(Mono.just(request), OrderConfirmationRequest.class)
                .exchange()
                .expectStatus().isOk();
    }
}
