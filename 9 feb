import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import javax.validation.Valid;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/courses")
@RequiredArgsConstructor
@Slf4j
public class CourseController {
    
    private final CourseService courseService;

    @PostMapping
    public ResponseEntity<CourseDTO> createCourse(@Valid @RequestBody CourseRequestDTO request) {
        log.info("POST /api/courses - Creating course: {}", request.getTitle());
        CourseDTO response = courseService.createCourse(request);
        log.info("Course created successfully with ID: {}", response.getId());
        return new ResponseEntity<>(response, HttpStatus.CREATED);
    }

    @GetMapping
    public ResponseEntity<List<CourseDTO>> getAllCourses() {
        log.info("GET /api/courses - Fetching all courses");
        List<CourseDTO> courses = courseService.getAllCourses();
        if (courses.isEmpty()) {
            log.warn("No courses found");
            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
        }
        log.info("Found {} courses", courses.size());
        return ResponseEntity.ok(courses);
    }

    @GetMapping("/active")
    public ResponseEntity<List<CourseDTO>> getActiveCourses() {
        log.info("GET /api/courses/active - Fetching active courses");
        List<CourseDTO> courses = courseService.getActiveCourses();
        if (courses.isEmpty()) {
            log.warn("No active courses found");
            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
        }
        log.info("Found {} active courses", courses.size());
        return ResponseEntity.ok(courses);
    }

    @GetMapping("/upcoming")
    public ResponseEntity<List<CourseDTO>> getUpcomingCourses() {
        log.info("GET /api/courses/upcoming - Fetching upcoming courses");
        List<CourseDTO> courses = courseService.getUpcomingCourses();
        if (courses.isEmpty()) {
            log.warn("No upcoming courses found");
            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
        }
        log.info("Found {} upcoming courses", courses.size());
        return ResponseEntity.ok(courses);
    }

    @GetMapping("/{id}")
    public ResponseEntity<Course> getCourseById(@PathVariable Long id) {
        log.info("GET /api/courses/{} - Fetching course", id);
        Course course = courseService.getCourseById(id);
        return ResponseEntity.ok(course);
    }

    @GetMapping("/exists/{id}")
    public ResponseEntity<Boolean> checkCourseExists(@PathVariable Long id) {
        log.info("GET /api/courses/exists/{} - Checking if course exists", id);
        boolean exists = courseService.courseExists(id);
        return ResponseEntity.ok(exists);
    }

    @GetMapping("/count-by-category")
    public ResponseEntity<List<Map<String, Object>>> getCourseCountByCategory() {
        log.info("GET /api/courses/count-by-category - Fetching course counts by category");
        List<Map<String, Object>> counts = courseService.getCourseCountByCategory();
        return ResponseEntity.ok(counts);
    }
