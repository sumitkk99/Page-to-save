package com.enrollment.studentservice.controller;

import com.enrollment.studentservice.client.CourseClient;
import com.enrollment.studentservice.dto.StudentDTO;
import com.enrollment.studentservice.dto.StudentRequestDTO;
import com.enrollment.studentservice.entity.Student;
import com.enrollment.studentservice.service.StudentService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import javax.validation.Valid;
import java.util.List;

@RestController
@RequestMapping("/api/students")
@RequiredArgsConstructor
@Slf4j
public class StudentController {
    
    private final StudentService studentService;
    private final CourseClient courseClient;

    @PostMapping
    public ResponseEntity<?> createStudent(@Valid @RequestBody StudentRequestDTO request) {
        log.info("POST /api/students - Registering student with email: {}", request.getEmail());
        try {
            StudentDTO response = studentService.registerStudent(request);
            log.info("Student registered with ID: {}", response.getId());
            return new ResponseEntity<>(response, HttpStatus.CREATED);
        } catch (Exception e) {
            log.error("Error registering student: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(e.getMessage());
        }
    }

    @PutMapping("/{id}/enroll/{courseId}")
    public ResponseEntity<?> enrollStudent(@PathVariable Long id, @PathVariable Long courseId) {
        log.info("PUT /api/students/{}/enroll/{} - Enrolling student", id, courseId);
        try {
            StudentDTO student = studentService.enrollStudent(id, courseId);
            log.info("Student enrolled successfully");
            return ResponseEntity.ok(student);
        } catch (RuntimeException e) {
            log.error("Error enrolling student: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.CONFLICT).body(e.getMessage());
        }
    }

    @GetMapping("/{id}")
    public ResponseEntity<?> getStudentById(@PathVariable Long id) {
        log.info("GET /api/students/{} - Fetching student", id);
        try {
            StudentDTO student = studentService.getStudentDTOById(id);
            return ResponseEntity.ok(student);
        } catch (Exception e) {
            log.warn("Student not found: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(e.getMessage());
        }
    }

    @GetMapping("/test-feign")
    public ResponseEntity<?> testFeignCourses(@RequestHeader(value = "Authorization", required = false) String token) {
        log.info("GET /api/students/test-feign - Testing Feign client");
        try {
            List<com.enrollment.studentservice.client.CourseDTO> courses = courseClient.getAllCourses();
            log.info("Feign client returned {} courses", courses.size());
            return ResponseEntity.ok(courses);
        } catch (Exception e) {
            log.error("Feign client error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Feign client error: " + e.getMessage());
        }
    }
}
