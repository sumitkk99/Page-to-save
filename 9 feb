import com.fasterxml.jackson.databind.ObjectMapper;
import onevz.soe.activation.controller.OrderConfirmationRedesignController;
import onevz.soe.activation.helper.OrderConfirmationRedesignHelper;
import onevz.soe.activation.helper.RedisHelper;
import onevz.soe.activation.service.OrderConfirmationRedesignService;
import onevz.soe.activation.ui.request.OrderConfirmationRequest;
import onevz.soe.activation.digital.soe.redesign.OrderConfirmationRedesignResponse;
import onevz.soe.activation.helper.ErrorHandlerHelper;
import onevz.soe.activation.integration.FeatureFlagIntegrationService;
import onevz.soe.activation.ui.response.RedisReqData;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.reactive.server.WebTestClient;
import reactor.core.publisher.Mono;

import static org.mockito.ArgumentMatchers.any;

@ExtendWith(MockitoExtension.class)
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
public class OrderConfirmationRedesignControllerTest2 {

    @Autowired
    private WebTestClient webTestClient; // ✅ Fix: Autowired properly

    @Autowired
    private OrderConfirmationRedesignController controller; // ✅ Fix: Autowired instead of InjectMocks

    @MockBean
    private RedisHelper redisHelper;

    @MockBean
    private OrderConfirmationRedesignHelper orderConfirmationRedesignHelper;

    @MockBean
    private ErrorHandlerHelper errorHandler;

    @MockBean
    private OrderConfirmationRedesignService service;

    @MockBean
    private FeatureFlagIntegrationService featureFlagIntegrationService;

    private OrderConfirmationRequest request;
    private OrderConfirmationRedesignResponse response;

    @BeforeEach
    public void setup() throws Exception {
        ObjectMapper mapper = new ObjectMapper();

        String requestString = TestingHelper.readFromFile("OrderConfirmationRequest.json");
        String responseString = TestingHelper.readFromFile("OrderConfirmationRedesignResponse.json");

        request = mapper.readValue(requestString, OrderConfirmationRequest.class);
        response = mapper.readValue(responseString, OrderConfirmationRedesignResponse.class);

        RedisReqData redisReq = RedisReqData.builder()
                .cartId("")
                .userDeviceType("desktop")
                .cjevent("cjevent")
                .affiliate("affiliate")
                .completedCartId("3efad59a-f94e-45fa-9ed9-fd72aeae9bd5")
                .build();

        // ✅ Mock dependencies
        Mockito.when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReq));
        Mockito.when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(any())).thenReturn(Mono.just(Boolean.TRUE));
        Mockito.when(service.getConfirmationPageRedesignInfo(any())).thenReturn(Mono.just(response));
        Mockito.when(redisHelper.upsertDataInRedis(any())).thenReturn(Mono.just(true));
        Mockito.when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(any(), any())).thenReturn(response);
    }

    @Test
    public void initBinderByNameTest() {
        assert controller != null;
    }

    @Test
    public void testGetConfirmationRedesignPageInfo() {
        webTestClient.post()
                .uri("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .accept(MediaType.APPLICATION_JSON)
                .header("channelId", "VZW-MFA-ANDROID")
                .header("x-soe-apikey", "uFWjz14du5e46whYg73iCGqriX2162C9")
                .header("UserAgent", "MF")
                .body(Mono.just(request), OrderConfirmationRequest.class)
                .exchange()
                .expectStatus().isOk();
    }
}
