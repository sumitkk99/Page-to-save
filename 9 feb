public static String getDeviceType(String pUserAgent) { 
    if (pUserAgent == null || pUserAgent.trim().isEmpty()) {
        return null;  // Fix: return null instead of "DESKTOP"
    }

    if ("MF".equalsIgnoreCase(pUserAgent)) {
        return pUserAgent;
    }

    String pUserAgentLowerCase = pUserAgent.toLowerCase();

    if ((pUserAgentLowerCase.contains("windows") && pUserAgentLowerCase.contains("touch"))
        || pUserAgentLowerCase.contains("tablet") || pUserAgentLowerCase.contains("ipad")) {
        return "TABLET";
    } 
    
    if ((pUserAgentLowerCase.contains("mobile") && pUserAgentLowerCase.contains("android"))
        || pUserAgentLowerCase.contains("windows phone") || pUserAgentLowerCase.contains("mobile")) {
        return "MOBILE";
    } 

    if (pUserAgentLowerCase.contains("android")) {
        return "TABLET";
    }

    return "DESKTOP";  // Default case remains the same
}
