public Mono<OrderConfirmationRedesignResponse> setFeatureFlags(OrderConfirmationRedesignResponse orderConfirmationRedesignResponse) {
    return Mono.justOrEmpty(orderConfirmationRedesignResponse.getFeatureFlags()) // Get existing flags reactively
            .defaultIfEmpty(new HashMap<>()) // Ensure it's not null
            .map(existingFlags -> {
                // Add SHOW_MULTIPLE_ORDER_NUMBERS_IN_IOC_FLAG reactively
                existingFlags.putIfAbsent(ActivationConstants.SHOW_MULTIPLE_ORDER_NUMBERS_IN_IOC_FLAG,
                        featureFlagIntegrationService.showMultipleOrderNumbersInIOCFFlag());

                log.info("Final featureFlagsMap before setting in response: {}", existingFlags);
                orderConfirmationRedesignResponse.setFeatureFlags(existingFlags);

                return orderConfirmationRedesignResponse;
            });
}
