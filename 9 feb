    featureFlagsMap.put("someFeature", true);
    Mockito.when(featureFlagHelper.getFeatureFlagsWithThrottle(Mockito.anyString()))
           .thenReturn(Mono.just(featureFlagsMap));
    
    // Call the method under test
    Mono<CompareQuotesResponse> compareQuotesRespMono = quoteService.mergeCompareQuotes(
            Mono.just(current),
            Mono.just(quote1),
            Mono.just(quote2),
            Mono.just(quote3),
