# Go to project root where src folder is
cd path\to\INSRestMonProcService

# Export full code of all .java files into one file
Get-ChildItem -Recurse -Include *.java | 
    ForEach-Object { Get-Content $_.FullName } |
    Out-File project-fullcode.txt

