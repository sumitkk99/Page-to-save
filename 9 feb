QuoteService quoteService = new QuoteService();
    
    // Mock any dependencies that quoteService might have
    QuoteServiceHelper quoteServiceHelper = Mockito.mock(QuoteServiceHelper.class);
    FeatureFlagHelper featureFlagHelper = Mockito.mock(FeatureFlagHelper.class);
    QuoteServiceProperties quoteServiceProperties = Mockito.mock(QuoteServiceProperties.class);
    
    // Set up the mocks
    Mockito.when(quoteServiceProperties.getEnableResponseMock()).thenReturn(true);
    
    // Set mocked objects into quoteService using reflection or constructor
