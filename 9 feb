package onevz.soe.activation.test.controller;

import com.fasterxml.jackson.databind.ObjectMapper;
import onevz.soe.activation.controller.OrderConfirmationRedesignController;
import onevz.soe.activation.digital.soe.redesign.OrderConfirmationRedesignResponse;
import onevz.soe.activation.helper.*;
import onevz.soe.activation.model.RedisReqData;
import onevz.soe.activation.service.OrderConfirmationRedesignService;
import onevz.soe.activation.test.config.ActivationServiceTestConfig;
import onevz.soe.activation.test.helper.TestingHelper;
import onevz.soe.activation.ui.request.OrderConfirmationRequest;
import onevz.soe.security.model.SsoJwtDTO;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.reactive.AutoConfigureWebTestClient;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.context.ContextConfiguration;
import org.springframework.test.context.junit4.SpringRunner;
import org.springframework.test.web.reactive.server.WebTestClient;
import reactor.core.publisher.Mono;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@RunWith(SpringRunner.class)
@ContextConfiguration(classes = { ActivationServiceTestConfig.class })
@AutoConfigureWebTestClient
public class OrderConfirmationRedesignControllerTest {

    @Autowired
    private WebTestClient webTestClient;

    @MockBean
    private RedisHelper redisHelper;

    @MockBean
    private OrderConfirmationRedesignService orderConfirmationRedesignService;

    @MockBean
    private FeatureFlagIntegrationService featureFlagIntegrationService;

    @MockBean
    private OrderConfirmationRedesignHelper orderConfirmationRedesignHelper;

    @MockBean
    private ErrorHandlerHelper errorHandler;

    @Test
    public void testGetConfirmationRedesignPageInfo_Success() throws Exception {
        // Mock Redis data
        RedisReqData redisReqData = RedisReqData.builder()
                .cartId("cart123")
                .completedCartId("completedCart123")
                .affiliate("affiliate123")
                .cjevent("cjevent123")
                .build();

        when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReqData));
        when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(any())).thenReturn(Mono.just(true));

        // Mock service response
        OrderConfirmationRedesignResponse response = new OrderConfirmationRedesignResponse();
        when(orderConfirmationRedesignService.getConfirmationPageRedesignInfo(any())).thenReturn(Mono.just(response));

        // Perform the test
        webTestClient.post()
                .uri("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .bodyValue(new OrderConfirmationRequest())
                .exchange()
                .expectStatus().isOk();
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_NoCartId() throws Exception {
        // Mock Redis data with no cartId
        RedisReqData redisReqData = RedisReqData.builder()
                .cartId(null)
                .completedCartId(null)
                .build();

        when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReqData));
        when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(any())).thenReturn(Mono.just(true));

        // Perform the test
        webTestClient.post()
                .uri("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .bodyValue(new OrderConfirmationRequest())
                .exchange()
                .expectStatus().isOk()
                .expectBody()
                .jsonPath("$.status").isEqualTo("Failed");
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_FeatureFlagFalse() throws Exception {
        // Mock Redis data
        RedisReqData redisReqData = RedisReqData.builder()
                .cartId("cart123")
                .completedCartId("completedCart123")
                .build();

        when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReqData));
        when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(any())).thenReturn(Mono.just(false));

        // Perform the test
        webTestClient.post()
                .uri("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .bodyValue(new OrderConfirmationRequest())
                .exchange()
                .expectStatus().isOk();
    }
}
