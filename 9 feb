Test
public void testCompareQuotes() throws IOException {
    // Setup test data
    List<CompareQuoteResponse> compareQuoteResponsesList = new ArrayList<>();
    CompareQuoteRequest compareQuoteRequest = new CompareQuoteRequest();
    QuoteTimer timer = new QuoteTimer();
    SOEError sOEError = new SOEError();
    DueMonthly dueMonthly = new DueMonthly();
    DueToday dueToday = new DueToday();
    List<SOEError> metrics = new ArrayList<>();
    
    sOEError.setMessage("Error Msg");
    metrics.add(sOEError);
    
    dueMonthly.setDueMonthlyChargesTotal("12");
    dueToday.setDueTodayChargesTotal("100");
    
    // Set up the CompareQuoteRequest with required values
    compareQuoteRequest.setFullAccNumber("A");
    compareQuoteRequest.setCart1("cart1");
    compareQuoteRequest.setCart2("cart2");
    compareQuoteRequest.setCart3("cart3");
    
    // Create the current quote response
    CompareQuoteResponse current = new CompareQuoteResponse();
    current.setMetrics(metrics);
    current.setQuoteLabel("Current");
    compareQuoteResponsesList.add(current);
    
    // Create the quote1 response
    CompareQuoteResponse quote1 = new CompareQuoteResponse();
    quote1.setMetrics(metrics);
    quote1.setDueMonthly(dueMonthly);
    quote1.setDueToday(dueToday);
    quote1.setQuoteLabel("Quote 1");
    compareQuoteResponsesList.add(quote1);
    
    // Create the quote2 response
    CompareQuoteResponse quote2 = new CompareQuoteResponse();
    quote2.setMetrics(metrics);
    quote2.setDueMonthly(dueMonthly);
    quote2.setDueToday(dueToday);
    quote2.setQuoteLabel("Quote 2");
    compareQuoteResponsesList.add(quote2);
    
    // Create the quote3 response
    CompareQuoteResponse quote3 = new CompareQuoteResponse();
    quote3.setMetrics(metrics);
    quote3.setDueMonthly(dueMonthly);
    quote3.setDueToday(dueToday);
    quote3.setQuoteLabel("Quote 3");
    compareQuoteResponsesList.add(quote3);
    
    // Initialize the quoteService
    QuoteService quoteService = new QuoteService();
    
    // Mock any dependencies that quoteService might have
    QuoteServiceHelper quoteServiceHelper = Mockito.mock(QuoteServiceHelper.class);
    FeatureFlagHelper featureFlagHelper = Mockito.mock(FeatureFlagHelper.class);
    QuoteServiceProperties quoteServiceProperties = Mockito.mock(QuoteServiceProperties.class);
    
    // Set up the mocks
    Mockito.when(quoteServiceProperties.getEnableResponseMock()).thenReturn(true);
    
    // Set mocked objects into quoteService using reflection or constructor
    // This part depends on how quoteService is implemented
    // For example: 
    // ReflectionTestUtils.setField(quoteService, "quoteServiceHelper", quoteServiceHelper);
    // ReflectionTestUtils.setField(quoteService, "featureFlagHelper", featureFlagHelper);
    // ReflectionTestUtils.setField(quoteService, "quoteServiceProperties", quoteServiceProperties);
    
    // Setup mocks for the populateCompareQuotesValues method
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, null))
           .thenReturn(Mono.just(current));
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, compareQuoteRequest.getCart1()))
           .thenReturn(Mono.just(quote1));
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, compareQuoteRequest.getCart2()))
           .thenReturn(Mono.just(quote2));
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, compareQuoteRequest.getCart3()))
           .thenReturn(Mono.just(quote3));
    
    // Mock feature flag
    Map<String, Boolean> featureFlagsMap = new HashMap<>();
    featureFlagsMap.put("someFeature", true);
    Mockito.when(featureFlagHelper.getFeatureFlagsWithThrottle(Mockito.anyString()))
           .thenReturn(Mono.just(featureFlagsMap));
    
    // Call the method under test
    Mono<CompareQuotesResponse> compareQuotesRespMono = quoteService.mergeCompareQuotes(
            Mono.just(current),
            Mono.just(quote1),
            Mono.just(quote2),
            Mono.just(quote3),
            timer,
            compareQuoteRequest
    );
    
    // Assert the result
    StepVerifier.create(compareQuotesRespMono)
                .expectNextMatches(response -> {
                    List<CompareQuoteResponse> responses = response.getCompareQuoteResponses();
                    return responses.size() == 4 &&
                           responses.get(0).getQuoteLabel().equals("Current") &&
                           responses.get(1).getQuoteLabel().equals("Quote 1") &&
                           responses.get(2).getQuoteLabel().equals("Quote 2") &&
                           responses.get(3).getQuoteLabel().equals("Quote 3");
                })
                .verifyComplete();
    
    // Test the compareQuotes method
    Mono<CompareQuotesResponse> cqpResponse = quoteService.compareQuotes(compareQuoteRequest);
    
    // Verify the result
    StepVerifier.create(cqpResponse)
                .expectNext(Mockito.any(CompareQuotesResponse.class))
                .verifyComplete();
}
