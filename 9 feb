@Test
void testSetPromoDiscountInfoToMonthlyAddons_Promo1DescNull() {
    // Arrange
    ChargeDetails accMonthlyChrgs = new ChargeDetails();
    accMonthlyChrgs.setPromo1Discount("10%");
    accMonthlyChrgs.setPromo1Desc(null);  // Promo1Desc is null

    AddOnsChanrgesDetail monthlyAddon = new AddOnsChanrgesDetail();
    boolean isPromoOrderFFlagEnabled = true;

    // Act
    setPromoDiscountInfoToMonthlyAddons(accMonthlyChrgs, isPromoOrderFFlagEnabled, monthlyAddon);

    // Assert
    assertNull(monthlyAddon.getPromoDiscountInfo());  // No promo should be added
}



