@Test
public void testGetConfirmationRedesignPageInfo_IgnoreChannelsPath() throws Exception {
    // Load JSON request and response from test files
    String requestString = TestingHelper.readFromFile("OrderConfirmationRequest.json");
    String responseString = TestingHelper.readFromFile("OrderConfirmationRedesignResponse.json");

    ObjectMapper mapper = new ObjectMapper();  
    OrderConfirmationRequest request = mapper.readValue(requestString, OrderConfirmationRequest.class);  
    OrderConfirmationRedesignResponse response = mapper.readValue(responseString, OrderConfirmationRedesignResponse.class);  

    // Mock Redis response with non-null completedCartId, non-null cartId to ensure we pass initial validations
    RedisReqData redisReq = RedisReqData.builder()  
            .completedCartId("test-completed-cart-id")  
            .cartId("test-cart-id")  
            .affiliate(null)  
            .cjevent(null)  
            .build();  

    // Set up the ignoreChannels list with the channel we'll use in the test
    ReflectionTestUtils.setField(controller, "ignoreChannels", Arrays.asList("TEST-CHANNEL"));

    // Mock all required service responses
    Mockito.when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReq));  
    Mockito.when(service.getConfirmationPageRedesignInfo(Mockito.any())).thenReturn(Mono.just(response));  
    Mockito.when(redisHelper.upsertDataInRedis(Mockito.any())).thenReturn(Mono.just(true));  
    Mockito.when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(Mockito.any(), Mockito.any()))
            .thenReturn(response);
    
    // Mock necessary helper methods
    Mockito.when(redisHelper.getAffiliateFromHeader(Mockito.any())).thenReturn("test-affiliate");
    Mockito.when(redisHelper.getCjeventFromHeader(Mockito.any())).thenReturn("test-cjevent");

    // Execute test - using TEST-CHANNEL and deliberately NOT sending User-Agent
    WebTestClient.ResponseSpec responseSpec = webTestClient.post()  
            .uri("/getConfirmationRedesignPage")  
            .contentType(MediaType.APPLICATION_JSON)  
            .accept(MediaType.APPLICATION_JSON)  
            .header("channelid", "TEST-CHANNEL")  
            .header("x-soe-apikey", "uFWjzl4du5e46whYg73iCGqriX216209")
            // Deliberately not sending User-Agent to make userDeviceType null
            .body(Mono.just(request), OrderConfirmationRequest.class)  
            .exchange()  
            .expectStatus().isOk();
    
    // Verify the response body
    OrderConfirmationRedesignResponse result = responseSpec.expectBody(OrderConfirmationRedesignResponse.class)
            .returnResult()
            .getResponseBody();
    assertNotNull(result);
    
    // Verify that the service method was called
    Mockito.verify(service).getConfirmationPageRedesignInfo(Mockito.any());
}
