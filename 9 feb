# Go to your project root where src folder exists
cd path\to\INSRestMonProcService

# Extract only class/interface/enum definitions + annotations + method signatures
Get-ChildItem -Recurse -Include *.java |
    Select-String -Pattern '(^\s*(public|protected|private)?\s*(class|interface|enum)\s+\w+)|(^\s*@\w+)|(^\s*(public|protected|private).*\))' |
    ForEach-Object { $_.Line } |
    Out-File project-skeleton.txt
