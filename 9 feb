import com.fasterxml.jackson.databind.ObjectMapper;
import onevz.soe.activation.controller.OrderConfirmationRedesignController;
import onevz.soe.activation.helper.OrderConfirmationRedesignHelper;
import onevz.soe.activation.helper.RedisHelper;
import onevz.soe.activation.model.RedisReqData;
import onevz.soe.activation.service.OrderConfirmationRedesignService;
import onevz.soe.activation.ui.request.OrderConfirmationRequest;
import onevz.soe.activation.digital.soe.redesign.OrderConfirmationRedesignResponse;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpHeaders;
import org.springframework.http.server.reactive.ServerHttpRequest;
import org.springframework.http.server.reactive.ServerHttpResponse;
import reactor.core.publisher.Mono;
import reactor.test.StepVerifier;

import java.util.Collections;
import java.util.List;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
public class OrderConfirmationRedesignControllerTest {

    @InjectMocks
    private OrderConfirmationRedesignController controller;

    @Mock
    private OrderConfirmationRedesignService service;

    @Mock
    private RedisHelper redisHelper;

    @Mock
    private OrderConfirmationRedesignHelper orderConfirmationRedesignHelper;

    @Mock
    private ServerHttpRequest mockRequest;

    @Mock
    private ServerHttpResponse mockResponse;

    private final ObjectMapper mapper = new ObjectMapper();
    private OrderConfirmationRequest request;
    private OrderConfirmationRedesignResponse response;
    private RedisReqData redisReq;

    @BeforeEach
    public void setup() throws Exception {
        String requestString = TestingHelper.readFromFile("OrderConfirmationRequest.json");
        String responseString = TestingHelper.readFromFile("OrderConfirmationRedesignResponse.json");

        request = mapper.readValue(requestString, OrderConfirmationRequest.class);
        response = mapper.readValue(responseString, OrderConfirmationRedesignResponse.class);

        redisReq = RedisReqData.builder()
                .cartId("")
                .userDeviceType("desktop")
                .cjevent("cjevent")
                .affiliate("affiliate")
                .completedCartId("")
                .build();

        Mockito.when(mockRequest.getHeaders()).thenReturn(new HttpHeaders());
        Mockito.when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReq));
        Mockito.when(service.getConfirmationPageRedesignInfo(Mockito.any())).thenReturn(Mono.just(response));
        Mockito.when(redisHelper.upsertDataInRedis(Mockito.any())).thenReturn(Mono.just(true));
        Mockito.when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(Mockito.any(), Mockito.any()))
                .thenReturn(response);
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_Success() {
        Mono<OrderConfirmationRedesignResponse> result = controller.getConfirmationRedesignPageInfo(mockRequest, mockResponse, request);

        StepVerifier.create(result)
                .expectNext(response)
                .verifyComplete();
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_CartIdMissing() {
        redisReq = RedisReqData.builder().cartId(null).completedCartId(null).build();
        Mockito.when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReq));

        Mono<OrderConfirmationRedesignResponse> result = controller.getConfirmationRedesignPageInfo(mockRequest, mockResponse, request);

        StepVerifier.create(result)
                .expectNextMatches(res -> res.getStatus().equals("Failed") && res.getErrors() != null)
                .verifyComplete();
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_ExceptionHandling() {
        Mockito.when(service.getConfirmationPageRedesignInfo(Mockito.any()))
                .thenThrow(new RuntimeException("Service Failure"));

        Mono<OrderConfirmationRedesignResponse> result = controller.getConfirmationRedesignPageInfo(mockRequest, mockResponse, request);

        StepVerifier.create(result)
                .expectError(RuntimeException.class)
                .verify();
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_UserAgentHeader() {
        HttpHeaders headers = new HttpHeaders();
        headers.put("UserAgent", List.of("Test-Agent"));
        Mockito.when(mockRequest.getHeaders()).thenReturn(headers);

        Mono<OrderConfirmationRedesignResponse> result = controller.getConfirmationRedesignPageInfo(mockRequest, mockResponse, request);

        StepVerifier.create(result)
                .expectNext(response)
                .verifyComplete();
    }
}
