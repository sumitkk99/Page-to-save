    @BeforeEach
    public void setup() throws Exception {
        // Initialize test data
        String requestString = TestingHelper.readFromFile("OrderConfirmationRequest.json");
        String responseString = TestingHelper.readFromFile("OrderConfirmationRedesignResponse.json");
        
        ObjectMapper mapper = new ObjectMapper();
        request = mapper.readValue(requestString, OrderConfirmationRequest.class);
        response = mapper.readValue(responseString, OrderConfirmationRedesignResponse.class);
        
        // Create sample SsoJwtDTO
        ssoJwtDTO = new SsoJwtDTO();
        ssoJwtDTO.setVzwAccountNumber("123456789");
        
        // Setup feature flag response
        featureFlagResponse = new HashMap<>();
        featureFlagResponse.put("isEnabled", true);
    }

    @Test
    public void testGetConfirmationRedesignPageInfo_Success() {
        // Setup Redis data
        redisReq = RedisReqData.builder()
                .cartId("")
                .userDeviceType("desktop")
                .cjevent("cjevent")
                .affiliate("affiliate")
                .completedCartId("3efad59a-f94e-45fa-9ed9-fd72aeae9bd5")
                .build();
        
        // Mock responses
        Mockito.when(tokenProcessorHelper.getSsoJwtTokenObject(Mockito.any(ServerHttpRequest.class)))
                .thenReturn(ssoJwtDTO);
                
        Mockito.when(redisHelper.getConfirmationPageDataFromRedis())
                .thenReturn(Mono.just(redisReq));
                
        Mockito.when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(Mockito.anyString()))
                .thenReturn(Mono.just(featureFlagResponse));
                
        Mockito.when(service.getConfirmationPageRedesignInfo(Mockito.any()))
                .thenReturn(Mono.just(response));
                
        Mockito.when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(
                Mockito.anyString(), Mockito.any()))
                .thenReturn(response);
                
        Mockito.when(redisHelper.upsertDataInRedis(Mockito.any()))
                .thenReturn(Mono.just(true));
                
        Mockito.when(redisHelper.deleteKeysFromRedis(Mockito.anyList()))
                .thenReturn(Mono.just(true));

        // Perform test
        webTestClient.post().uri("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .accept(MediaType.APPLICATION_JSON)
                .header("channelid", "VZW-DOTCOM")
                .header("x-soe-apikey", "uFwjz14du5e46whYg731CGqriX2162C9")
                .header("UserAgent", "MF")
                .body(Mono.just(request), OrderConfirmationRequest.class)
                .exchange()
                .expectStatus().isOk();

        // Verify mocks
        Mockito.verify(featureFlagIntegrationService).orderConfirmationCloudFixFFlag(Mockito.anyString());
        Mockito.verify(orderConfirmationRedesignHelper).setFeatureFlags(Mockito.any(), Mockito.any());
    }

