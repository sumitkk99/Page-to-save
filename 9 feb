Test
public void setFeatureFlags_ShouldReturnWhenSsoJwtDtoIsNullOrInvalid() {
    OrderConfirmationRedesignResponse response = new OrderConfirmationRedesignResponse();

    // Case 1: ssoJwtDTO is null
    orderConfirmationRedesignHelper.setFeatureFlags(response, null);
    assertNull(response.getFeatureFlags());

    // Case 2: ssoJwtDTO with null vzwAccountNumber
    SsoJwtDTO mockSsoJwtDTO = mock(SsoJwtDTO.class);
    when(mockSsoJwtDTO.getVzwAccountNumber()).thenReturn(null);
    orderConfirmationRedesignHelper.setFeatureFlags(response, mockSsoJwtDTO);
    assertNull(response.getFeatureFlags());

    // Case 3: ssoJwtDTO with empty vzwAccountNumber
    when(mockSsoJwtDTO.getVzwAccountNumber()).thenReturn("");
    orderConfirmationRedesignHelper.setFeatureFlags(response, mockSsoJwtDTO);
    assertNull(response.getFeatureFlags());
}

@Test
public void setFeatureFlags_ShouldHandleNullFeatureFlagsMap() {
    OrderConfirmationRedesignResponse response = new OrderConfirmationRedesignResponse();
    SsoJwtDTO mockSsoJwtDTO = mock(SsoJwtDTO.class);
    when(mockSsoJwtDTO.getVzwAccountNumber()).thenReturn("123456789");

    // Simulate null featureFlagsMap
    when(featureFlagIntegrationService.getFeatureFlagsWithThrottle(any()))
            .thenReturn(Mono.just(null));

    orderConfirmationRedesignHelper.setFeatureFlags(response, mockSsoJwtDTO);

    // Verify that a new HashMap is initialized
    assertNotNull(response.getFeatureFlags());
    assertTrue(response.getFeatureFlags().isEmpty());
}
