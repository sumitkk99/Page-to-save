@ExtendWith(MockitoExtension.class)
public class OrderConfirmationRedesignControllerTest1 {

    @InjectMocks
    private OrderConfirmationRedesignController controller;

    @Mock
    private OrderConfirmationRedesignService orderConfrimSer;

    @Mock
    private SsoJwtTokenProcessorHelper tokenProcessorHelper;

    @Mock
    private RedisHelper redisHelper;

    @Mock
    private OrderConfirmationRedesignHelper orderConfirmationRedesignHelper;

    @Mock
    private ErrorHandlerHelper errorHandler;

    @Mock
    private ServerHttpRequest request;

    @Mock
    private ServerHttpResponse response;

    @Mock
    private OrderConfirmationRequest orderConfirmationRequest;

    @BeforeEach
    public void setup() {
        // Manually initializing ignoreChannels
        ReflectionTestUtils.setField(controller, "ignoreChannels", 
            Arrays.asList("VZW-TOUCHLESSVM", "EXPRESS-STORE", "EXPRESS-PEDESTAL"));

        // Other setup tasks
    }

    @Test
    public void testGetConfirmationRedesignPageInfo() throws SOEHTTPException {
        // Mocking dependencies
        when(tokenProcessorHelper.getSsoJwtTokenObject(any())).thenReturn(new SsoJwtDTO());

        when(redisHelper.getConfirmationPageDataFromRedis())
            .thenReturn(Mono.just(new RedisReqData()));

        when(orderConfrimSer.getConfirmationPageRedesignInfo(any()))
            .thenReturn(Mono.just(new OrderConfirmationRedesignResponse()));

        when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(any(), any()))
            .thenReturn(new OrderConfirmationRedesignResponse());

        // Mocking request headers
        HttpHeaders headers = new HttpHeaders();
        headers.put("UserAgent", Collections.singletonList("Mozilla/5.0"));
        when(request.getHeaders()).thenReturn(headers);

        MultiValueMap<String, HttpCookie> cookies = new LinkedMultiValueMap<>();
        when(request.getCookies()).thenReturn(cookies);

        // Calling the method under test
        Mono<OrderConfirmationRedesignResponse> result =
            controller.getConfirmationRedesignPageInfo(request, response, orderConfirmationRequest);

        // Verifying the result
        StepVerifier.create(result)
            .expectNextMatches(response -> response.getStatus().equals("Success"))
            .verifyComplete();
    }
}
