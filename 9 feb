    // Setup mocks for the populateCompareQuotesValues method
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, null))
           .thenReturn(Mono.just(current));
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, compareQuoteRequest.getCart1()))
           .thenReturn(Mono.just(quote1));
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, compareQuoteRequest.getCart2()))
           .thenReturn(Mono.just(quote2));
    Mockito.when(quoteServiceHelper.populateCompareQuotesValues(compareQuoteRequest, compareQuoteRequest.getCart3()))
