package onevz.soe.activation.controller;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import com.fasterxml.jackson.databind.ObjectMapper;
import onevz.soe.activation.helper.*;
import onevz.soe.activation.model.RedisReqData;
import onevz.soe.activation.service.OrderConfirmationRedesignService;
import onevz.soe.activation.ui.request.OrderConfirmationRequest;
import onevz.soe.activation.digital.soe.redesign.OrderConfirmationRedesignResponse;
import onevz.soe.constants.SOEConstants;
import onevz.soe.logging.constant.LogConstants;
import onevz.soe.security.model.SsoJwtDTO;
import onevz.soe.spring.web.filter.RequestAccessContext;
import onevz.soe.utilities.StringUtilities;
import onevz.soe.wsclient.http.exceptions.SOEHTTPException;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.context.junit.jupiter.SpringExtension;
import org.springframework.test.web.servlet.MockMvc;
import reactor.core.publisher.Mono;

import java.util.Arrays;
import java.util.List;
import java.util.Optional;

@ExtendWith(SpringExtension.class)
@WebMvcTest(OrderConfirmationRedesignController.class)
public class OrderConfirmationRedesignControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @MockBean
    private OrderConfirmationRedesignService orderConfirmService;

    @MockBean
    private SsoJwtTokenProcessorHelper tokenProcessorHelper;

    @MockBean
    private RedisHelper redisHelper;

    @MockBean
    private OrderConfirmationRedesignHelper orderConfirmationRedesignHelper;

    @MockBean
    private FeatureFlagIntegrationService featureFlagIntegrationService;

    @MockBean
    private ErrorHandlerHelper errorHandler;

    @InjectMocks
    private OrderConfirmationRedesignController orderConfirmationRedesignController;

    @Autowired
    private ObjectMapper objectMapper;

    private OrderConfirmationRequest orderConfirmationRequest;
    private SsoJwtDTO ssoJwtDTO;
    private RedisReqData redisReqData;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        orderConfirmationRequest = new OrderConfirmationRequest();
        ssoJwtDTO = new SsoJwtDTO();
        redisReqData = new RedisReqData();

        // Mocking behavior
        when(tokenProcessorHelper.getSsoJwtTokenObject(any())).thenReturn(ssoJwtDTO);
        when(redisHelper.getConfirmationPageDataFromRedis()).thenReturn(Mono.just(redisReqData));
        when(featureFlagIntegrationService.orderConfirmationCloudFixFFlag(any())).thenReturn(Mono.just(true));
    }

    /**
     * **Test Case 1:** Validate Success Response when data is present in Redis
     */
    @Test
    void testGetConfirmationRedesignPageInfo_Success() throws Exception {
        // Given
        redisReqData.setCompletedCartId("12345");
        OrderConfirmationRedesignResponse response = new OrderConfirmationRedesignResponse();
        response.setStatus("Success");

        when(orderConfirmService.getConfirmationPageRedesignInfo(any())).thenReturn(Mono.just(response));
        when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(any(), any())).thenReturn(response);

        // When & Then
        mockMvc.perform(post("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(orderConfirmationRequest)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("Success"));
    }

    /**
     * **Test Case 2:** Validate failure when no cartId or completedCartId is present in Redis
     */
    @Test
    void testGetConfirmationRedesignPageInfo_CartIdNotPresent() throws Exception {
        // Given
        redisReqData.setCartId(null);
        redisReqData.setCompletedCartId(null);

        when(errorHandler.convertExceptionToSOEErrorID(any(), any(), any())).thenReturn("CartId is not present");
        
        // When & Then
        mockMvc.perform(post("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(orderConfirmationRequest)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("Failed"))
                .andExpect(jsonPath("$.errors").value("CartId is not present"));
    }

    /**
     * **Test Case 3:** Validate error response when order is not submitted yet
     */
    @Test
    void testGetConfirmationRedesignPageInfo_OrderNotSubmitted() throws Exception {
        // Given
        redisReqData.setCartId("someCartId");
        redisReqData.setCompletedCartId(null);

        when(errorHandler.convertExceptionToSOEError(any(), any())).thenReturn("Order is not submitted yet");

        // When & Then
        mockMvc.perform(post("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(orderConfirmationRequest)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("Failed"))
                .andExpect(jsonPath("$.errors").value("Order is not submitted yet"));
    }

    /**
     * **Test Case 4:** Validate response when affiliate is missing and is retrieved from header
     */
    @Test
    void testGetConfirmationRedesignPageInfo_AffiliateMissing() throws Exception {
        // Given
        redisReqData.setAffiliate(null);
        redisReqData.setCompletedCartId("12345");
        when(redisHelper.getAffiliateFromHeader(any())).thenReturn("AFF123");

        OrderConfirmationRedesignResponse response = new OrderConfirmationRedesignResponse();
        response.setStatus("Success");

        when(orderConfirmService.getConfirmationPageRedesignInfo(any())).thenReturn(Mono.just(response));
        when(orderConfirmationRedesignHelper.updateConfirmationRedesignResponse(any(), any())).thenReturn(response);

        // When & Then
        mockMvc.perform(post("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(orderConfirmationRequest)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("Success"));
    }

    /**
     * **Test Case 5:** Validate handling of exceptions
     */
    @Test
    void testGetConfirmationRedesignPageInfo_ExceptionHandling() throws Exception {
        // Given
        when(orderConfirmService.getConfirmationPageRedesignInfo(any())).thenThrow(new RuntimeException("Internal Server Error"));

        // When & Then
        mockMvc.perform(post("/getConfirmationRedesignPage")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(orderConfirmationRequest)))
                .andExpect(status().is5xxServerError());
    }
}
