package com.enrollment.courseservice.controller;

import com.enrollment.courseservice.entity.Course;
import com.enrollment.courseservice.service.CourseService;
import jakarta.validation.Valid;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/courses")
public class CourseController {

    private static final Logger logger =
            LoggerFactory.getLogger(CourseController.class);

    private final CourseService courseService;

    public CourseController(CourseService courseService) {
        this.courseService = courseService;
    }

    @PostMapping
    public ResponseEntity<Course> createCourse(
            @Valid @RequestBody Course course) {

        logger.info("Received request to create course: {}",
                course.getTitle());

        Course createdCourse =
                courseService.createCourse(course);

        logger.info("Course created successfully");

        return ResponseEntity
                .status(HttpStatus.CREATED)
                .body(createdCourse);
    }

    @GetMapping
    public ResponseEntity<List<Course>> getAllCourses() {

        logger.info("Fetching all courses");

        return ResponseEntity.ok(
                courseService.getAllCourses()
        );
    }

    @GetMapping("/active")
    public ResponseEntity<List<Course>> getActiveCourses() {

        logger.info("Fetching active courses");

        return ResponseEntity.ok(
                courseService.getActiveCourses()
        );
    }

    @GetMapping("/upcoming")
    public ResponseEntity<?> getUpcomingCourses() {

        logger.info("Fetching upcoming courses");

        List<Course> upcomingCourses =
                courseService.getUpcomingCourses();

        if (upcomingCourses.isEmpty()) {

            return ResponseEntity
                    .status(HttpStatus.NOT_FOUND)
                    .body("No upcoming courses found");
        }

        return ResponseEntity.ok(upcomingCourses);
    }

    @GetMapping("/{id}")
    public ResponseEntity<?> getCourseById(
            @PathVariable Long id) {

        logger.info("Fetching course with id {}", id);

        Course course =
                courseService.getCourseById(id);

        if (course == null) {

            return ResponseEntity
                    .status(HttpStatus.NOT_FOUND)
                    .body("Course not found");
        }

        return ResponseEntity.ok(course);
    }
}







