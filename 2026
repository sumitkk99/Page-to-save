package com.enrollment.studentservice.service.impl;

import com.enrollment.studentservice.client.CourseFeignClient;
import com.enrollment.studentservice.dto.CourseDTO;
import com.enrollment.studentservice.dto.StudentDTO;
import com.enrollment.studentservice.dto.StudentRequestDTO;
import com.enrollment.studentservice.entity.Student;
import com.enrollment.studentservice.exception.StudentAlreadyExistsException;
import com.enrollment.studentservice.exception.StudentNotFoundException;
import com.enrollment.studentservice.repository.StudentRepository;
import com.enrollment.studentservice.service.StudentService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@RequiredArgsConstructor
@Slf4j
public class StudentServiceImpl implements StudentService {
    
    private final StudentRepository studentRepository;
    private final CourseFeignClient courseFeignClient;

    @Override
    @Transactional
    public StudentDTO registerStudent(StudentRequestDTO request) {
        log.info("Registering new student with email: {}", request.getEmail());
        
        if (studentRepository.existsByEmail(request.getEmail())) {
            throw new StudentAlreadyExistsException("Student with email " + request.getEmail() + " already exists");
        }
        
        Student student = new Student();
        student.setName(request.getName());
        student.setEmail(request.getEmail());
        student.setEnrolledCourseIds(new java.util.ArrayList<>());
        
        Student savedStudent = studentRepository.save(student);
        log.info("Student registered successfully with ID: {}", savedStudent.getId());
        
        return mapToDTO(savedStudent);
    }

    @Override
    @Transactional
    public StudentDTO enrollStudent(Long studentId, Long courseId) {
        log.info("Enrolling student {} in course {}", studentId, courseId);
        
        Student student = getStudentById(studentId);
        
        // Check if course exists via Feign Client
        try {
            boolean courseExists = courseFeignClient.courseExists(courseId);
            if (!courseExists) {
                log.warn("Course not found with ID: {}", courseId);
                throw new RuntimeException("Course not found with id: " + courseId);
            }
        } catch (Exception e) {
            log.error("Error calling Course Service: {}", e.getMessage());
            throw new RuntimeException("Course service unavailable");
        }
        
        // Check if already enrolled
        if (student.getEnrolledCourseIds().contains(courseId)) {
            log.warn("Student {} already enrolled in course {}", studentId, courseId);
            throw new RuntimeException("Student is already enrolled in this course");
        }
        
        student.getEnrolledCourseIds().add(courseId);
        Student updatedStudent = studentRepository.save(student);
        log.info("Student {} enrolled in course {} successfully", studentId, courseId);
        
        return mapToDTO(updatedStudent);
    }

    @Override
    public Student getStudentById(Long id) {
        log.info("Fetching student by ID: {}", id);
        return studentRepository.findById(id)
                .orElseThrow(() -> {
                    log.warn("Student not found with ID: {}", id);
                    return new StudentNotFoundException("Student not found with id: " + id);
                });
    }

    @Override
    @Transactional(readOnly = true)
    public StudentDTO getStudentDTOById(Long id) {
        Student student = getStudentById(id);
        return mapToDTO(student);
    }

    private StudentDTO mapToDTO(Student student) {
        return new StudentDTO(
                student.getId(),
                student.getName(),
                student.getEmail(),
                student.getEnrolledCourseIds()
        );
    }
}
