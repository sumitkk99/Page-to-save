package com.enrollment.gateway.config;

import org.springframework.cloud.gateway.route.RouteLocator;
import org.springframework.cloud.gateway.route.builder.RouteLocatorBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
public class GatewayConfig {

    @Bean
    public RouteLocator customRouteLocator(RouteLocatorBuilder builder) {
        return builder.routes()
                .route("course-service", r -> r
                        .path("/api/courses/**")
                        .filters(f -> f
                                .circuitBreaker(config -> config.setName("courseCircuitBreaker"))
                                .rewritePath("/api/courses/(?<segment>.*)", "/api/courses/${segment}"))
                        .uri("lb://course-service"))
                .route("student-service", r -> r
                        .path("/api/students/**")
                        .filters(f -> f
                                .circuitBreaker(config -> config.setName("studentCircuitBreaker"))
                                .rewritePath("/api/students/(?<segment>.*)", "/api/students/${segment}"))
                        .uri("lb://student-service"))
                .route("auth-service", r -> r
                        .path("/auth/**")
                        .uri("lb://course-service"))
                .build();
    }
}
